# Server-only placeholders. Merge with your existing local server configuration.
# Never prefix these variables with NEXT_PUBLIC_ or commit a populated .env.
MONGODB_URI=
AUTH_ALLOWED_ORIGINS=http://localhost:8081
AUTH_SESSION_TTL_SECONDS=28800
BOOTSTRAP_ADMIN_EMAIL=techyfelloww@gmail.com
# Supply locally through a hidden prompt; minimum 12 characters. Leave this example blank.
BOOTSTRAP_ADMIN_PASSWORD=
EMAIL_ENABLED=false

# Community attachment scanning: trusted private ClamAV clamd endpoint.
# Missing/unreachable/failed scanning quarantines files; local scanner: docker-compose.scan.local.yml.
MALWARE_SCANNER_HOST=
MALWARE_SCANNER_PORT=3310
COMMUNITY_FLAG_TERMS=[]
COMMUNITY_MAX_LINKS=8

# Embedded durable attachment scan worker (disabled in isolated tests by default).
ATTACHMENT_SCAN_WORKER_ENABLED=true
